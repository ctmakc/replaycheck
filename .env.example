# Agent wallet. Generate a fresh key for the agent; never reuse a personal wallet.
REPLAYCHECK_AGENT_PRIVATE_KEY=0x...
# celo (default, real money) or celo-sepolia (buy gateway sandbox, free test USDC)
REPLAYCHECK_NETWORK=celo-sepolia
# ERC-8004 agent id once registered (npm run register)
REPLAYCHECK_AGENT_ID=
# Optional: the ERC-8021 code your hackathon entry shows (defaults to codeFromRepo(REPLAYCHECK_REPO))
REPLAYCHECK_ATTRIBUTION_CODE=
REPLAYCHECK_REPO=ctmakc/replaycheck
# Spending guards (atomic USDC units, 6 decimals)
REPLAYCHECK_MAX_CALL_ATOMIC=20000
REPLAYCHECK_MAX_RUN_ATOMIC=500000
# Seller side: key from x402.celo.org (npm run x402-key), used by `buy gate`
BUY_FACILITATOR_API_KEY=
