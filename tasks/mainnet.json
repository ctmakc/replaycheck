{
  "tasks": [
    {
      "id": "login-ok",
      "name": "Sign in with valid credentials reaches the secure area",
      "startUrl": "https://the-internet.herokuapp.com/login",
      "steps": [
        { "action": "fill", "target": "#username", "text": "tomsmith" },
        { "action": "fill", "target": "#password", "text": "SuperSecretPassword!" },
        { "action": "click", "target": "button[type=submit]" },
        { "action": "wait", "target": "#flash" }
      ],
      "expect": [
        { "urlContains": "/secure" },
        { "judge": "The page greets a signed-in user and offers a way to log out." }
      ]
    },
    {
      "id": "login-regression",
      "name": "A wrong password is rejected with a clear message",
      "startUrl": "https://the-internet.herokuapp.com/login",
      "steps": [
        { "action": "fill", "target": "#username", "text": "tomsmith" },
        { "action": "fill", "target": "#password", "text": "wrong-password" },
        { "action": "click", "target": "button[type=submit]" },
        { "action": "wait", "target": "#flash" }
      ],
      "expect": [
        { "judge": "The page tells the user their password is invalid and does not show the secure area.", "fallbackTextContains": "Your password is invalid" }
      ]
    }
  ]
}
